{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial-approval-package.v1",
  "title": "EditorialApprovalPackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "editorialArtifactId", "revision", "sourceProvenance", "approvedArtifact", "approval", "fingerprints", "editorialApprovalGranted"],
  "properties": {
    "schemaVersion": { "const": "editorial-approval-package.v1" },
    "packageId": { "type": "string", "minLength": 1 },
    "editorialArtifactId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIntakeId", "intakeRepository", "intakeIssueNumber", "sourceUrl", "sourceBodySha256", "editorialAgentRunId"],
      "properties": {
        "sourceIntakeId": { "type": "string", "minLength": 1 },
        "intakeRepository": { "type": "string", "minLength": 1 },
        "intakeIssueNumber": { "type": "integer", "minimum": 1 },
        "sourceUrl": { "type": "string", "minLength": 1 },
        "sourceBodySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "editorialAgentRunId": { "type": "string", "minLength": 1 }
      }
    },
    "approvedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "title", "body", "externalReferences", "relatedDfwConnections"],
      "properties": {
        "documentType": { "enum": ["seed", "note", "field-report", "essay", "experiment", "prototype-note", "concept", "checkpoint", "project-log"] },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "externalReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": { "url": { "type": "string", "minLength": 1 }, "title": { "type": "string" } }
          }
        },
        "relatedDfwConnections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference"],
            "properties": { "reference": { "type": "string", "minLength": 1 }, "note": { "type": "string" } }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvalMarker", "approvedAt"],
      "properties": {
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvalMarker": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentSha256", "packageSha256"],
      "properties": {
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "editorialApprovalGranted": { "const": true }
  }
}
