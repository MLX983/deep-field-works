{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepfieldworks.com/contracts/loop4-editorial-evaluation.v1.schema.json",
  "title": "loop4-editorial-evaluation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "sourcePacketSha256",
    "sourceDraftSha256",
    "sourceDraftReportSha256",
    "sourceEvaluationInputsSha256",
    "issueAndDraftReference",
    "verdict",
    "confidence",
    "blockingProblems",
    "revisionInstructions",
    "strengths",
    "risks",
    "evidenceUsed",
    "humanReviewNotes"
  ],
  "properties": {
    "contractVersion": { "const": "loop4-editorial-evaluation.v1" },
    "sourcePacketSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceDraftSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceDraftReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceEvaluationInputsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issueAndDraftReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "draftPath", "packetContract", "draftReportContract"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "issueUrl": { "type": "string" },
        "draftPath": { "type": "string", "minLength": 1 },
        "packetContract": { "const": "loop2-development-packet.v1" },
        "draftReportContract": { "enum": ["loop3-drafting-report.v1", "loop5-revision-report.v1"] }
      }
    },
    "verdict": { "enum": ["PASS_TO_HUMAN", "REVISE", "HOLD"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "blockingProblems": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "revisionInstructions": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
    "strengths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidenceUsed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "humanReviewNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
