{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepfieldworks.com/contracts/loop2-development-packet.v1.schema.json",
  "title": "loop2-development-packet.v1",
  "description": "Structured development packet produced by Loop 2 from an approved Loop 1 recommendation and source issue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "issueReference",
    "approvedArtifactType",
    "primaryDomain",
    "theme",
    "workingTitle",
    "readerQuestion",
    "centralTension",
    "verifiedObservations",
    "inferences",
    "speculation",
    "sourceRequirements",
    "evidenceGaps",
    "relatedMaterial",
    "recommendedStructure",
    "unresolvedQuestions",
    "draftReadiness",
    "nextAction",
    "sourceSufficiency"
  ],
  "properties": {
    "contractVersion": {
      "const": "loop2-development-packet.v1"
    },
    "issueReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "url"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "approvedArtifactType": { "type": "string", "minLength": 1 },
    "primaryDomain": {
      "type": "string",
      "enum": [
        "Cognitive Infrastructure",
        "Human-Machine Workflows",
        "Institutions in Transition",
        "Interfaces for Judgment",
        "Media, Memory, and Meaning"
      ]
    },
    "theme": { "type": "string" },
    "workingTitle": { "type": "string" },
    "readerQuestion": { "type": "string" },
    "centralTension": { "type": "string" },
    "verifiedObservations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inferences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "speculation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "developmentMaterial": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "role", "evidencePosture", "provenance"],
        "properties": {
          "content": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["mechanism", "example", "distinction", "framing", "hypothesis", "question", "caution"]
          },
          "evidencePosture": {
            "enum": ["inference", "speculation", "editorial-caution"]
          },
          "provenance": {
            "enum": ["source", "reviewed-recommendation", "both"]
          }
        }
      }
    },
    "sourceRequirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceGaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "relatedMaterial": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "role"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "recommendedStructure": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "draftReadiness": {
      "type": "string",
      "enum": [
        "ready",
        "research-required",
        "combine-first",
        "insufficient-material",
        "not-for-publication"
      ]
    },
    "nextAction": { "type": "string", "minLength": 1 },
    "sourceSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "missingElements"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["sufficient", "partial", "insufficient"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missingElements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "combinationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetReference",
        "materialToCarryForward",
        "doNotStandalone"
      ],
      "properties": {
        "targetReference": { "type": "string", "minLength": 1 },
        "targetTitle": { "type": "string" },
        "materialToCarryForward": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "doNotStandalone": { "type": "boolean" }
      }
    },
    "researchPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimsRequiringVerification",
        "evidenceNeededForReady"
      ],
      "properties": {
        "claimsRequiringVerification": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceNeededForReady": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prototypeNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designProblem",
        "interactionChoice",
        "interactionGroups",
        "designPrinciples",
        "currentState"
      ],
      "properties": {
        "designProblem": { "type": "string", "minLength": 1 },
        "interactionChoice": { "type": "string", "minLength": 1 },
        "interactionGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "items"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "designPrinciples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "currentState": { "type": "string", "minLength": 1 }
      }
    },
    "blockingCondition": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable explanation when draftReadiness is not ready."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "approvedArtifactType": { "const": "prototype-note" } },
        "required": ["approvedArtifactType"]
      },
      "then": { "required": ["prototypeNote"] }
    }
  ]
}
