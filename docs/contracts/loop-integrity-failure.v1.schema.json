{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepfieldworks.com/contracts/loop-integrity-failure.v1.schema.json",
  "title": "loop-integrity-failure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "stage", "status", "issueNumber", "failures"],
  "properties": {
    "contractVersion": { "const": "loop-integrity-failure.v1" },
    "stage": { "enum": ["loop4", "loop5"] },
    "status": { "const": "BLOCKED" },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "message"],
        "properties": {
          "artifact": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "expectedSha256": { "type": "string" },
          "actualSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
