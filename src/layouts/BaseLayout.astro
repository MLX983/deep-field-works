---
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string | URL | null;
  socialImage?: string | URL;
  socialImageWidth?: number;
  socialImageHeight?: number;
  socialImageAlt?: string;
  noindex?: boolean;
}

const defaultSocialImage = 'https://deepfieldworks.com/images/dfw-social-card.png';
const {
  title = 'Deep Field Works',
  description = 'Field notes on AI, systems, design, and emerging forms of work',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  socialImage = defaultSocialImage,
  socialImageWidth = socialImage.toString() === defaultSocialImage ? 1200 : undefined,
  socialImageHeight = socialImage.toString() === defaultSocialImage ? 630 : undefined,
  socialImageAlt = socialImage.toString() === defaultSocialImage
    ? 'Deep Field Works — field notes on AI, systems, design, and emerging forms of work'
    : undefined,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:site_name" content="Deep Field Works" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage.toString()} />
    {socialImageWidth && <meta property="og:image:width" content={socialImageWidth.toString()} />}
    {socialImageHeight && <meta property="og:image:height" content={socialImageHeight.toString()} />}
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    {canonicalURL && <meta property="og:url" content={canonicalURL.toString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Newsreader:wght@300;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <main id="top">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-400) var(--space-300) var(--space-900);
    background-color: var(--color-surface-primary);
    color: var(--color-text-body);
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  /* Canonical 390px mobile frames use a 358px rail and 16px gutters. */
  @media screen and (max-width: 390px) {
    body {
      padding-right: var(--space-200);
      padding-left: var(--space-200);
    }
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-serif);
    color: var(--color-text-header);
    line-height: var(--line-height-heading);
    font-weight: var(--font-weight-medium);
  }

  h1 {
    font-size: var(--font-size-title);
    margin: 0 0 var(--space-200);
  }

  h2 {
    font-size: var(--font-size-subheader);
    margin: var(--space-300) 0 var(--space-50);
  }

  h3 {
    font-size: var(--font-size-subheader);
    font-weight: var(--font-weight-light);
    margin: var(--space-300) 0 var(--space-100);
  }

  p {
    margin: 0 0 var(--space-200);
  }

  a {
    color: var(--color-text-link);
    text-decoration: underline;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  ul {
    padding-left: var(--space-300);
    margin: 0 0 var(--space-200);
  }

  li {
    margin: var(--space-50) 0;
  }

  blockquote {
    margin: var(--space-300) 0;
    padding: 0 var(--space-300);
    border: none;
    font-family: var(--font-serif);
    font-weight: var(--font-weight-light);
    font-size: var(--font-size-subheader);
    line-height: var(--line-height-heading);
    color: var(--color-text-header);
  }

  strong {
    font-weight: var(--font-weight-semibold);
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-300) 0;
  }

  /* Masthead — the home wordmark (Figma: Newsreader Light 32). */
  .masthead {
    margin: 0 0 var(--space-300);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-light);
    font-size: var(--font-size-title);
    line-height: var(--line-height-heading);
    color: var(--color-text-header);
  }

  /* Section / topic-block header (Figma: Newsreader Medium 24). */
  .section-head {
    margin: 0 0 var(--space-100);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-header);
    line-height: var(--line-height-heading);
    color: var(--color-text-header);
  }

  /* Link list (Figma: "Main link"). Links stay underlined at rest so they
     read as links on touch devices, where hover never fires. */
  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-50);
  }

  .link-list li {
    margin: 0;
  }

  .link-list a {
    font-weight: var(--font-weight-regular);
    text-decoration: underline;
  }
</style>
