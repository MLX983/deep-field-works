---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" href={withBase('favicon.ico')} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:wght@300;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <main id="top">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    color-scheme: light;
  }

  body {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-600) var(--space-300) var(--space-900);
    background-color: var(--color-surface-primary);
    color: var(--color-text-body);
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-serif);
    color: var(--color-text-header);
    line-height: var(--line-height-heading);
    font-weight: var(--font-weight-medium);
  }

  h1 {
    font-size: var(--font-size-title);
    margin: 0 0 var(--space-200);
  }

  h2 {
    font-size: var(--font-size-subheader);
    margin: var(--space-300) 0 var(--space-50);
  }

  h3 {
    font-size: var(--font-size-subheader);
    font-weight: var(--font-weight-light);
    margin: var(--space-300) 0 var(--space-100);
  }

  p {
    margin: 0 0 var(--space-200);
  }

  a {
    color: var(--color-text-link);
    text-decoration: underline;
  }

  ul {
    padding-left: var(--space-300);
    margin: 0 0 var(--space-200);
  }

  li {
    margin: var(--space-50) 0;
  }

  blockquote {
    margin: var(--space-300) 0;
    padding: 0 var(--space-300);
    border: none;
    font-family: var(--font-serif);
    font-weight: var(--font-weight-light);
    font-size: var(--font-size-subheader);
    line-height: var(--line-height-heading);
    color: var(--color-text-header);
  }

  strong {
    font-weight: var(--font-weight-semibold);
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-300) 0;
  }

  /* Masthead — the home wordmark (Figma: Newsreader Light 32). */
  .masthead {
    margin: 0 0 var(--space-300);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-light);
    font-size: var(--font-size-title);
    line-height: var(--line-height-heading);
    color: var(--color-text-header);
  }

  /* Section / topic-block header (Figma: Newsreader Medium 24). */
  .section-head {
    margin: 0 0 var(--space-100);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-header);
    line-height: var(--line-height-heading);
    color: var(--color-text-header);
  }

  /* Link list (Figma: "Main link"). Links stay underlined at rest so they
     read as links on touch devices, where hover never fires. */
  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-50);
  }

  .link-list li {
    margin: 0;
  }

  .link-list a {
    font-weight: var(--font-weight-regular);
    text-decoration: underline;
  }
</style>
