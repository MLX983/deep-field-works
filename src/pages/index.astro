---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { domains } from '../data/domains';
import { formatDomainLabel } from '../utils/formatDomainLabel';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const collectionNames = ['articles', 'field-notes', 'checkpoints'] as const;

const notDraftInProd = ({ data }: { data: { draft?: boolean } }) =>
  import.meta.env.PROD ? !data.draft : true;

const grouped = await Promise.all(
  collectionNames.map((name) => getCollection(name, notDraftInProd)),
);

const recent = grouped
  .flatMap((collection, index) =>
    collection.map((entry) => ({ entry, collection: collectionNames[index] })),
  )
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf())
  .slice(0, 5);

// Temporarily suppressed: the "Starting points" section is hidden until there
// are enough entries to make it useful. Restore the const + section below.
// const startingPoints = [
//   { label: 'Chronology', path: 'chronology' },
//   { label: 'Domains', path: 'domains' },
//   { label: 'Field Notes', path: 'field-notes' },
//   { label: 'Articles', path: 'articles' },
//   { label: 'Checkpoints', path: 'checkpoints' },
// ];
---

<BaseLayout
  title="Deep Field Works"
  description="A long-term field journal and laboratory notebook on humans, technology, knowledge systems, and artificial intelligence."
>
  <h1 class="masthead">Deep Field Works</h1>

  <p class="intro">
    Deep Field Works is a long-term field journal and laboratory notebook,
    recording how humans, knowledge systems, and artificial intelligence are
    changing one another.
  </p>

  <p class="intro">
    It is a working archive rather than a finished publication: the goal is to
    preserve thinking while it develops, and to keep the chronology intact.
  </p>

  {
    recent.length > 0 && (
      <section class="topic-block">
        <h2 class="section-head">Recent additions</h2>
        <ul class="link-list">
          {recent.map(({ entry, collection }) => (
            <li>
              <a href={withBase(`${collection}/${entry.id}`)}>
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Temporarily suppressed until there are enough entries to be useful:
  <section class="topic-block">
    <h2 class="section-head">Starting points</h2>
    <ul class="link-list">
      {
        startingPoints.map((point) => (
          <li>
            <a href={withBase(point.path)}>{point.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
  */}

  <section class="topic-block">
    <h2 class="section-head">Domains</h2>
    <ul class="link-list">
      {
        domains.map((domain) => (
          <li>
            <a href={withBase(`domains/${domain.slug}`)}>
              {formatDomainLabel(domain.title)}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    margin: 0 0 var(--space-300);
  }

  .topic-block {
    margin: 0 0 var(--space-300);
  }

  .topic-block:last-child {
    margin-bottom: 0;
  }
</style>
