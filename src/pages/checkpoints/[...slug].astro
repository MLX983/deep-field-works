---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import BackToTop from '../../components/BackToTop.astro';
import { resolveEntryDomain } from '../../data/domains';
import { formatDomainLabel } from '../../utils/formatDomainLabel';
import { getCollection, render } from 'astro:content';
import { notDraftInProd } from '../../utils/notDraftInProd';

export async function getStaticPaths() {
  const entries = await getCollection('checkpoints', notDraftInProd);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeLabels: Record<string, string> = {
  article: 'Article',
  'field-note': 'Field Note',
  checkpoint: 'Checkpoint',
  'research-note': 'Research Note',
  experiment: 'Experiment',
  'project-journal': 'Project Journal',
};

const monthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(entry.data.pubDate);

const domain = resolveEntryDomain(entry.data);
const domainLabel = domain?.title ?? entry.data.domainPath?.[0] ?? entry.data.theme;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const monthAnchor = withBase(
  `chronology#${entry.data.pubDate.getUTCFullYear()}-${String(
    entry.data.pubDate.getUTCMonth() + 1,
  ).padStart(2, '0')}`,
);
---

<BaseLayout title={`${entry.data.title} — Deep Field Works`} description={entry.data.description}>
  <BackLink />
  <article>
    <p>
      <small>
        {typeLabels[entry.data.documentType]}
        {domainLabel && (
          <>
            {' · '}
            {domain ? (
              <a href={withBase(`domains/${domain.slug}`)}>{formatDomainLabel(domain.title)}</a>
            ) : (
              <span>{domainLabel}</span>
            )}
          </>
        )}
        {' · '}
        <a href={monthAnchor}>{monthYear}</a>
      </small>
    </p>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>

  <BackToTop />
</BaseLayout>
