---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import BackToTop from '../../components/BackToTop.astro';
import EntryList, { type ListItem } from '../../components/EntryList.astro';
import { getCollection } from 'astro:content';
import { notDraftInProd } from '../../utils/notDraftInProd';
import { entryChronologyDate } from '../../utils/entryChronologyDate';

const entries = await getCollection('field-notes', notDraftInProd);

const items: ListItem[] = entries
  .map((entry) => ({ entry, collection: 'field-notes' as const }))
  .sort(
    (a, b) =>
      entryChronologyDate(b.entry.data).valueOf() - entryChronologyDate(a.entry.data).valueOf(),
  );
---

<BaseLayout
  title="Field Notes — Deep Field Works"
  description="Short observations, signals, and early interpretations captured before they harden into arguments."
>
  <BackLink />

  <h1>Field Notes</h1>

  <p>
    Field notes collect short observations, signals, and early interpretations.
    They preserve something worth keeping before it is developed enough for an
    article, and they are allowed to remain tentative.
  </p>

  <EntryList items={items} emptyMessage="No field notes yet." />

  <BackToTop />
</BaseLayout>
