---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('field-notes');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeLabels: Record<string, string> = {
  article: 'Article',
  'field-note': 'Field Note',
  checkpoint: 'Checkpoint',
  'research-note': 'Research Note',
  experiment: 'Experiment',
  'project-journal': 'Project Journal',
};

const monthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(entry.data.pubDate);

const metaSegments = [
  typeLabels[entry.data.documentType],
  entry.data.theme,
  monthYear,
].filter(Boolean);

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout title={`${entry.data.title} — Deep Field Works`} description={entry.data.description}>
  <article>
    <p>
      <small>{metaSegments.join(' · ')}</small>
    </p>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
    <hr />
    <Content />
  </article>
  <p><a href={withBase('')}>← Back to index</a></p>
</BaseLayout>
