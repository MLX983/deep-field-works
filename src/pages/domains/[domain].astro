---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { domains } from '../../data/domains';
import { getCollection } from 'astro:content';
import { notDraftInProd } from '../../utils/notDraftInProd';

export async function getStaticPaths() {
  return domains.map((domain) => ({
    params: { domain: domain.slug },
    props: { domain },
  }));
}

const { domain } = Astro.props;

const collectionNames = ['articles', 'field-notes', 'checkpoints'] as const;

const grouped = await Promise.all(
  collectionNames.map((name) => getCollection(name, notDraftInProd)),
);

const items = grouped
  .flatMap((collection, index) =>
    collection.map((entry) => ({ entry, collection: collectionNames[index] })),
  )
  .filter(
    ({ entry }) =>
      entry.data.domainPath?.includes(domain.title) ||
      entry.data.theme === domain.title,
  )
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  title={`${domain.title} — Deep Field Works`}
  description={domain.description}
>
  <BackLink />

  <h1>{domain.title}</h1>

  {
    items.length === 0 ? (
      <p>No entries are mapped to this domain yet.</p>
    ) : (
      <ul class="link-list">
        {items.map(({ entry, collection }) => (
          <li>
            <a href={withBase(`${collection}/${entry.id}`)}>{entry.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
