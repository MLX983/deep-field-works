---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="Domains — Deep Field Works"
  description="Manually curated pathways through the chronological archive."
>
  <h1>Domains</h1>

  <p>
    The archive itself is chronological. Entries appear in the order they were
    written, and that order is preserved on purpose.
  </p>

  <p>
    Domains are a second, slower layer on top of that record. Each domain is a
    manually curated pathway through related observations, articles, and
    checkpoints. They are assembled by hand rather than generated from tags or
    categories, so they reflect deliberate connections rather than automatic
    grouping.
  </p>

  <p>A domain is not a feed. It is a reading path.</p>

  <h2>Current domains</h2>
  <ul>
    <li><a href={withBase('domains/ai-adoption')}>AI Adoption</a></li>
  </ul>
</BaseLayout>
