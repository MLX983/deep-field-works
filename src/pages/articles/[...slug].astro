---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeLabels: Record<string, string> = {
  article: 'Article',
  'field-note': 'Field Note',
  checkpoint: 'Checkpoint',
  'research-note': 'Research Note',
  experiment: 'Experiment',
  'project-journal': 'Project Journal',
};

const monthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(entry.data.pubDate);

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout title={`${entry.data.title} — Deep Field Works`} description={entry.data.description}>
  <nav class="page-nav">
    <a class="page-nav__link" href={withBase('')}>
      <span class="page-nav__arrow">←</span> <span class="page-nav__label">Index</span>
    </a>
  </nav>
  <article class="article">
    <header class="article__header">
      <h1 class="article__title">{entry.data.title}</h1>
      <p class="article__meta">
        <span>{typeLabels[entry.data.documentType]}</span>
        {entry.data.theme && (
          <>
            <span class="article__meta-sep"> · </span>
            <span class="article__meta-theme">{entry.data.theme}</span>
          </>
        )}
        <span class="article__meta-sep"> · </span>
        <span>{monthYear}</span>
      </p>
    </header>
    <div class="article__body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article__header {
    margin-bottom: var(--space-300);
  }

  .article__title {
    margin-bottom: var(--space-50);
  }

  .article__meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-footnote);
    color: var(--color-text-muted);
  }

  .article__meta-theme {
    color: var(--color-text-link);
    text-decoration: underline;
  }

  .article__body :global(> p:first-child) {
    margin-top: 0;
  }

  .page-nav {
    margin-bottom: var(--space-200);
    font-family: var(--font-sans);
    font-size: var(--font-size-footnote);
  }

  .page-nav__link {
    color: var(--color-text-link);
    text-decoration: none;
  }

  .page-nav__label {
    text-decoration: underline;
  }
</style>
