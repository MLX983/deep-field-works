---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeLabels: Record<string, string> = {
  article: 'Article',
  'field-note': 'Field Note',
  checkpoint: 'Checkpoint',
  'research-note': 'Research Note',
  experiment: 'Experiment',
  'project-journal': 'Project Journal',
};

const monthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(entry.data.pubDate);

const metaSegments = [
  typeLabels[entry.data.documentType],
  entry.data.theme,
  monthYear,
].filter(Boolean);

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout title={`${entry.data.title} — Deep Field Works`} description={entry.data.description}>
  <article class="article">
    <header class="article__header">
      <h1 class="article__title">{entry.data.title}</h1>
      <p class="article__meta">{metaSegments.join(' · ')}</p>
    </header>
    <div class="article__body">
      <Content />
    </div>
  </article>
  <p class="article__back"><a href={withBase('')}>← Back to index</a></p>
</BaseLayout>

<style>
  .article__header {
    margin-bottom: var(--space-600);
  }

  .article__title {
    margin-bottom: var(--space-100);
  }

  .article__meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-footnote);
    color: var(--color-text-muted);
  }

  .article__body :global(> p:first-child) {
    margin-top: 0;
  }

  .article__back {
    margin-top: var(--space-900);
    font-size: var(--font-size-footnote);
  }
</style>
