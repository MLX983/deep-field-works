---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import BackToTop from '../../components/BackToTop.astro';
import { resolveEntryDomain } from '../../data/domains';
import { formatDomainLabel } from '../../utils/formatDomainLabel';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notDraftInProd = ({ data }: { data: { draft?: boolean } }) =>
    import.meta.env.PROD ? !data.draft : true;
  const entries = await getCollection('articles', notDraftInProd);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeLabels: Record<string, string> = {
  article: 'Article',
  'field-note': 'Field Note',
  checkpoint: 'Checkpoint',
  'research-note': 'Research Note',
  experiment: 'Experiment',
  'project-journal': 'Project Journal',
};

const monthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(entry.data.pubDate);

const domain = resolveEntryDomain(entry.data);
const domainLabel = domain?.title ?? entry.data.domainPath?.[0] ?? entry.data.theme;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const monthAnchor = withBase(
  `chronology#${entry.data.pubDate.getUTCFullYear()}-${String(
    entry.data.pubDate.getUTCMonth() + 1,
  ).padStart(2, '0')}`,
);
---

<BaseLayout title={`${entry.data.title} — Deep Field Works`} description={entry.data.description}>
  <BackLink />
  <article class="article">
    <header class="article__header">
      <h1 class="article__title">{entry.data.title}</h1>
      <p class="article__meta">
        <span>{typeLabels[entry.data.documentType]}</span>
        {domainLabel && (
          <>
            <span class="article__meta-sep"> · </span>
            {domain ? (
              <a class="article__meta-domain" href={withBase(`domains/${domain.slug}`)}>
                {formatDomainLabel(domain.title)}
              </a>
            ) : (
              <span>{domainLabel}</span>
            )}
          </>
        )}
        <span class="article__meta-sep"> · </span>
        <a class="article__meta-date" href={monthAnchor}>{monthYear}</a>
      </p>
    </header>
    <div class="article__body">
      <Content />
    </div>
  </article>

  <BackToTop />
</BaseLayout>

<style>
  .article__header {
    margin-bottom: var(--space-300);
  }

  .article__title {
    margin-bottom: var(--space-50);
  }

  .article__meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-footnote);
    color: var(--color-text-muted);
  }

  .article__meta-domain {
    color: var(--color-text-link);
    text-decoration: underline;
  }

  .article__meta-date {
    color: var(--color-text-link);
    text-decoration: underline;
  }

  .article__body :global(> p:first-child) {
    margin-top: 0;
  }
</style>
