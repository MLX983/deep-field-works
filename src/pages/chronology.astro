---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackLink from '../components/BackLink.astro';
import { getCollection } from 'astro:content';

const collectionNames = ['articles', 'field-notes', 'checkpoints'] as const;

const notDraftInProd = ({ data }: { data: { draft?: boolean } }) =>
  import.meta.env.PROD ? !data.draft : true;

const grouped = await Promise.all(
  collectionNames.map((name) => getCollection(name, notDraftInProd)),
);

const entries = grouped
  .flatMap((collection, index) =>
    collection.map((entry) => ({ entry, collection: collectionNames[index] })),
  )
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf());

const monthFormat = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  timeZone: 'UTC',
});

// Group: year -> month index -> entries (all kept in descending date order).
type Item = (typeof entries)[number];
const years = new Map<number, Map<number, Item[]>>();
for (const item of entries) {
  const d = item.entry.data.pubDate;
  const year = d.getUTCFullYear();
  const month = d.getUTCMonth();
  const months = years.get(year) ?? new Map<number, Item[]>();
  const bucket = months.get(month) ?? [];
  bucket.push(item);
  months.set(month, bucket);
  years.set(year, months);
}

const sortedYears = [...years.keys()].sort((a, b) => b - a);
const monthAnchor = (year: number, month: number) =>
  `${year}-${String(month + 1).padStart(2, '0')}`;

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="Chronology — Deep Field Works"
  description="A chronological field log of every entry, in the order it was written."
>
  <BackLink />

  <h1>Chronology</h1>

  <p>
    Every entry, in the order it was written. The sequence is preserved on
    purpose: it shows when ideas appeared and where earlier thinking shifted.
  </p>

  {entries.length === 0 && <p>No entries yet.</p>}

  {
    sortedYears.map((year) => {
      const months = years.get(year)!;
      const sortedMonths = [...months.keys()].sort((a, b) => b - a);
      return (
        <section class="chrono-year">
          <h2 class="section-head">{year}</h2>
          {sortedMonths.map((month) => (
            <div class="chrono-month">
              <h3 class="chrono-month__label" id={monthAnchor(year, month)}>
                {monthFormat.format(months.get(month)![0].entry.data.pubDate)}
              </h3>
              <ul class="link-list">
                {months.get(month)!.map(({ entry, collection }) => (
                  <li>
                    <a href={withBase(`${collection}/${entry.id}`)}>
                      {entry.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .chrono-year {
    margin: 0 0 var(--space-300);
  }

  .chrono-year:last-child {
    margin-bottom: 0;
  }

  .chrono-month {
    margin: 0 0 var(--space-300);
  }

  .chrono-month:last-child {
    margin-bottom: 0;
  }

  .chrono-month__label {
    margin: 0 0 var(--space-100);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-subheader);
    line-height: var(--line-height-heading);
    color: var(--color-text-header);
  }
</style>
